# ========================================================
# Cloud-Based Online Complaint Management System
# Cloud Technology Semester 5 Micro Project Environment Config
# ========================================================

# Server Configuration (PaaS)
PORT=3000
NODE_ENV=development

# Cloud Database (DBaaS) - MongoDB Atlas
# If left empty, the application seamlessly uses Cloud-Emulated Persistent Storage
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cloud_complaints?retryWrites=true&w=majority

# Cloud Object Storage - Cloudinary (Free Cloud Bucket)
# If left empty, the system falls back to Local Cloud-Emulated Object Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloud Email Notification Service (MaaS / FaaS)
# Optional: Configure SMTP or leave blank for Cloud Console simulation
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@cloudcomplaint.io

# Security & Cloud Access Control
ADMIN_ACCESS_KEY=cloud-admin-secret-2026
